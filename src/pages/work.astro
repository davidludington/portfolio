---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillGrid from '../components/SkillGrid.astro';
import Icon from '../components/Icon.astro';
import Contact from '../components/Contact.astro';
import { currentRole, education, experience, site } from '../data/site';
import { frameworks, languages } from '../data/skills';
import { icon } from '../data/icons';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={`Work | ${site.name}`} description="Projects, frameworks, and languages.">
	<section id="about" class="pt-20 xl:pt-40 px-4 md:px-8 lg:px-40">
		<!-- <h1 class="title text-3xl md:text-4xl lg:text-5xl text-center mb-8">Work</h1> -->
		<div class="section-container max-w-4xl mx-auto justify-center">
			<div
				class="about-details-container flex flex-col md:flex-row gap-4 md:gap-8 justify-center"
			>
				{
					[currentRole, education].map((item) => (
						<div
							class="details-container flex-1 text-center p-6 bg-card rounded-2xl border border-borderLight"
						>
<Icon
							image={icon(item.icon)}
							alt={`${item.title} icon`}
							class="icon icon-mono w-8 h-8 mx-auto mb-4"
						/>
							<h3 class="text-lg md:text-xl text-textPrimary mb-2">{item.title}</h3>
							<p class="text-textSecondary">
								{'role' in item ? (
									<>
										{item.role}
										<br />
										{item.company}
									</>
								) : (
									<>
										{item.degree}
										<br />
										{item.field}
									</>
								)}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</section>


	<section id="experience" class="pt-20 xl:pt-40 px-4 md:px-8 lg:px-40">
		<!-- <p class="section__text__p1 text-textSecondary text-center mb-2">Explore My</p> -->
		<h1 class="title text-3xl md:text-4xl lg:text-5xl text-center mb-8">Experience</h1>
		<div class="experience-details-container max-w-5xl mx-auto">
			<div class="details-container p-6 bg-card rounded-2xl border border-borderLight mb-6 md:mb-8">
				<div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-4">
					<div>
						<h2 class="text-xl md:text-2xl text-textPrimary font-semibold">{experience.role}</h2>
						<p class="text-textSecondary">{experience.company}</p>
					</div>
					<span
						class="self-start text-xs md:text-sm text-textSecondary px-3 py-1 rounded-full border border-borderLight"
					>
						{experience.period}
					</span>
				</div>
				<p class="text-textSecondary mb-4">{experience.summary}</p>
				<ul class="list-disc marker:text-accent pl-5 space-y-2 text-textPrimary mb-6">
					{experience.bullets.map((bullet) => <li>{bullet}</li>)}
				</ul>
				<h3 class="text-lg md:text-xl text-textSecondary font-semibold mb-4">
					End-to-end UI test suites built from the ground up for:
				</h3>
				<div class="grid grid-cols-2 md:grid-cols-4 gap-3">
					{
						experience.games.map((game) => (
							<a
								href={game.href}
								target="_blank"
								rel="noopener noreferrer"
								class="group flex flex-col p-4 bg-bg rounded-xl border border-borderLight hover:border-accent transition-colors"
							>
								<span class="text-textPrimary font-medium group-hover:text-accent">{game.name}</span>
								<span class="text-xs text-textSecondary">Visit game ↗</span>
							</a>
						))
					}
				</div>
			</div>
			<div class="grid md:grid-cols-2 gap-6 md:gap-8">
				<SkillGrid title="Frameworks" skills={frameworks} />
				<SkillGrid title="Languages" skills={languages} />
			</div>
		</div>
	</section>

	<section id="projects" class="pt-20 xl:pt-40 px-4 md:px-8 lg:px-40">
		<p class="section__text__p1 text-textSecondary text-center mb-2">Browse My Recent</p>
		<h1 class="title text-3xl md:text-4xl lg:text-5xl text-center mb-8">Projects</h1>
		<div class="experience-details-container max-w-5xl mx-auto">
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
				{projects.map((project) => <ProjectCard project={project} />)}
			</div>
		</div>
	</section>
	<Contact />
</BaseLayout>
