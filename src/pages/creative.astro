---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const albums = (await getCollection('albums')).sort((a, b) => a.data.order - b.data.order);

const albumCards = albums.map((album) => ({
	album,
	cover: album.data.photos[0],
}));
---

<BaseLayout
	title={`Creative | ${site.name}`}
	description="Pictures and process from my creative work."
>
	<section
		id="creative"
		class="min-h-screen flex flex-col items-center pt-20 xl:pt-40 pb-8 px-4"
	>
		<!-- <h1 class="title text-3xl md:text-4xl lg:text-5xl text-center mb-8">Creative Works</h1> -->
    <div class="mt-8 mb-8 mx-auto max-w-7xl rounded-2xl border border-border bg-card p-6 text-left">
      <p>I'm a leatherworker and maker based in New York City, with a background in computer science.</p>
      <p><br>I'm drawn to making because I enjoy understanding how things work and figuring out how to make them well. My interests center around working with materials like leather, denim, and canvas. I'm especially interested in the construction itself—the way materials behave, the techniques, tools, and decisions that go into creating something functional and durable.</p>
      <p><br>For me, making is as much about the process as the finished object. I enjoy learning new techniques, experimenting with different materials, and working through the small problems that come with trying to build something by hand. There's something satisfying about developing an understanding of a material through experience and gradually becoming more precise and intentional in how I work.</p>
    </div>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 max-w-7xl w-full">
			{
				albumCards.map(({ album, cover }) => (
					<a
						href={`/creative/${album.id}`}
						class="group relative block overflow-hidden rounded-2xl border border-border"
					>
						{cover && (
							<Image
								src={cover}
								alt={album.data.title}
								width={800}
								widths={[400, 800]}
								sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
								quality={75}
								loading="lazy"
								class="fashion-img w-full aspect-square object-cover"
							/>
						)}
						<div
							class="pointer-events-none absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/75 via-black/20 to-transparent p-4 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
						>
							<h2 class="text-lg md:text-xl font-semibold text-white">
								{album.data.title}
							</h2>
							{album.data.description && (
								<p class="text-sm text-white/80">{album.data.description}</p>
							)}
						</div>
					</a>
				))
			}
		</div>
	</section>
</BaseLayout>
